    { "name": "unknown nested field", "base": "observation-detected.ci.v1.json", "set": { "source.actor": "someone" }, "expect": { "ok": false, "path": "$.source.actor" } },
    { "name": "missing eventId", "base": "observation-detected.ci.v1.json", "unset": [ "eventId" ], "expect": { "ok": false, "path": "$.eventId" } },
    { "name": "eventId not v4", "base": "observation-detected.ci.v1.json", "set": { "eventId": "6819b08b-f3b5-1a58-9a0a-4fc13be29c1a" }, "expect": { "ok": false, "path": "$.eventId" } },
    { "name": "eventId uppercase", "base": "observation-detected.ci.v1.json", "set": { "eventId": "6819B08B-F3B5-4A58-9A0A-4FC13BE29C1A" }, "expect": { "ok": false, "path": "$.eventId" } },
    { "name": "unsupported schemaVersion", "base": "observation-detected.ci.v1.json", "set": { "schemaVersion": "2.0" }, "expect": { "ok": false, "path": "$.schemaVersion", "code": "unsupported_version" } },
    { "name": "unknown eventType", "base": "observation-detected.ci.v1.json", "set": { "eventType": "defect.confirmed" }, "expect": { "ok": false, "path": "$.eventType" } },
