  "promotion": {
    "description": "Explicit authorized action that creates a NEW defect identity linked to the observation (VIT-LCY-002). The observation keeps its own identity and state; it gains only a link event.",
    "fromMachine": "observation",
    "fromState": "classified",
    "toMachine": "defect",
    "toState": "new",
    "roles": [
      "triager",
      "administrator"
    ],
    "reasonRequired": true,
    "requiredFields": [
      "defectId"
    ],
    "defectIdPattern": "^DEF-[0-9]{4,}$"
  },
  "facts": {
    "description": "Fix facts are separate append-only events, never lifecycle states (VIT-VER-005 groundwork, P1). Recording a fact never changes state.",
    "machine": "defect",
    "kinds": {
      "fix-proposed": {
        "roles": [
          "triager",
