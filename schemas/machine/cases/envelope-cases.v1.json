    { "name": "summary of 200 astral code points accepted", "base": "observation-detected.ci.v1.json", "repeat": { "path": "finding.summary", "char": "😀", "count": 200 }, "expect": { "ok": true } },
    { "name": "observed over 1000 code points", "base": "observation-detected.ci.v1.json", "repeat": { "path": "finding.observed", "char": "y", "count": 1001 }, "expect": { "ok": false, "path": "$.finding.observed" } },
