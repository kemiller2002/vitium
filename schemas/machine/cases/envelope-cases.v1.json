    { "name": "bidi override in summary", "base": "observation-detected.ci.v1.json", "set": { "finding.summary": "Routing ‮failed" }, "expect": { "ok": false, "path": "$.finding.summary" } },
    { "name": "zero-width space in summary", "base": "observation-detected.ci.v1.json", "set": { "finding.summary": "Routing​failed" }, "expect": { "ok": false, "path": "$.finding.summary" } },
