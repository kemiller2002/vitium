<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EchelonFoundry.Vitium.Contracts</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>Echelon Foundry</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Versioned, typed observations and verification contracts for Echelon Foundry Vitium.</Description>
    <PackageTags>echelon;vitium;defect;reporting;contracts</PackageTags>
    <PackageProjectUrl>https://github.com/kemiller2002/vitium</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kemiller2002/vitium</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Contracts.fs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
