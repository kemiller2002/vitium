{
  "schemaVersion": "1.0",
  "description": "Shared machine-envelope cases. Each case starts from an example under schemas/machine/examples/, applies `set` (dotted path -> JSON value) and `unset` (dotted paths), `ownKey` ({at: dotted path, or \"\" for the root; key; value}: defines an OWN enumerable property, so inherited names such as __proto__ become real JSON keys exactly as JSON.parse produces them; VF-029), `setJoined` (dotted path -> string parts concatenated at runtime, so credential-shaped test inputs never appear literally in tracked files), and states the expected verdict of BOTH the JSON Schema (ajv) and service/machine/contract.mjs validateEnvelope. `runtimeOnly: true` marks the only documented divergence class: calendar-range checks that JSON Schema patterns cannot express; the schema accepts, the runtime refuses. `core` (optional) is the expected machine-intake error code after authentication, for cases that pass structure but fail screening.",
  "cases": [
    { "name": "sample: ci observation is valid", "base": "observation-detected.ci.v1.json", "expect": { "ok": true } },
    { "name": "sample: dokimos failed verification is valid", "base": "verification-failed.dokimos.v1.json", "expect": { "ok": true } },
    { "name": "sample: dokimos passed verification is valid", "base": "verification-passed.dokimos.v1.json", "expect": { "ok": true } },
    { "name": "sample: ci inconclusive verification is valid", "base": "verification-inconclusive.ci.v1.json", "expect": { "ok": true } },
    { "name": "sample: ordo governance violation is valid", "base": "governance-violation.ordo.v1.json", "expect": { "ok": true } },
    { "name": "sample: tutela security rule is valid", "base": "security-rule.tutela.v1.json", "expect": { "ok": true } },
    { "name": "runAttempt is optional", "base": "observation-detected.ci.v1.json", "unset": [ "subject.runAttempt" ], "expect": { "ok": true } },
    { "name": "originMarker may be explicitly null", "base": "observation-detected.ci.v1.json", "set": { "correlation.originMarker": null }, "expect": { "ok": true } },
    { "name": "offset timestamp accepted", "base": "observation-detected.ci.v1.json", "set": { "observedAt": "2026-10-08T08:00:00.123-04:00" }, "expect": { "ok": true } },
    { "name": "ten evidence items accepted", "base": "observation-detected.ci.v1.json", "evidenceCount": 10, "expect": { "ok": true } },
    { "name": "unicode text accepted", "base": "observation-detected.ci.v1.json", "set": { "finding.summary": "Échec du contrat de routage – 路由" }, "expect": { "ok": true } },
