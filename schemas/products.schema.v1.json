{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/vitium/products/1.0",
  "title": "Vitium canonical product registry",
  "description": "Structure of schemas/products.v1.json. Alias uniqueness and the single explicit 'unknown' entry are enforced by loadRegistry (service/product-registry.mjs) and Registry.parse (domain/Vitium.Domain).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "registryVersion", "products", "impacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "id": { "const": "vitium.products" },
    "registryVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "aliasMatching": { "type": "string" },
    "products": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "displayName", "aliases"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
          "aliasSource": { "type": "string" },
          "unknown": { "const": true }
        }
      }
    },
    "impacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "displayName"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    }
  }
}
