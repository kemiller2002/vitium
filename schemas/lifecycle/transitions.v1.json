  "evidenceRule": "evidenceAnyOf: the command must carry at least one evidence item whose kind is listed. An empty list means no evidence is required. Kind \"unspecified\" (legacy untyped evidence) never satisfies a non-empty requirement.",
  "policy": {
    "description": "Provisional policy values (DOM-001 sections 18-28). Not Ordo-authorized; every value here is a reversible engineering default awaiting an owner decision (VIT-OQ-012, VIT-VER-006/011). passRequiresHumanVerifier (provisional, integrator decision VF-028): a passing verification result needs provenance authenticated-human; agent, application and ci actors may record failed and inconclusive results only.",
    "maxAutonomousFailedAttempts": {
      "value": 3,
      "provisional": true,
      "description": "Failed verification results in the current open cycle after which a verification submission by an actor of provenance 'agent' is refused with escalation_required until a human records an escalation event. A parameter of the policy function; this is only its default."
    },
    "independentVerification": {
      "required": true,
      "appliesTo": [
        "passed"
      ],
      "provisional": true,
      "description": "A passing verification result may not be recorded by the submitter of the attempt. The attempt's author IS the submitting actor; an explicit 'author' is accepted only when it canonically equals that actor (VF-025). Actor identities are compared canonically: NFKC, trimmed, lower-cased (VF-026)."
    },
    "passRequiresHumanVerifier": true
  },
  "events": {
    "description": "Append-only events that never change state. 'verification-inconclusive' records a flaky/environmental run against the latest submission and leaves the defect awaiting verification; it never counts as a failure (VIT-VER-010). 'escalation' is a human decision that resets the autonomous repair budget for the open cycle (VIT-VER-011).",
    "verification-inconclusive": {
      "machine": "defect",
      "state": "awaiting-verification",
      "roles": [
        "verifier",
        "administrator"
      ],
      "requiredFields": [
        "attemptId",
        "candidateRevision"
      ],
      "evidenceAnyOf": [
        "verification-run"
      ],
      "reasonRequired": true
    },
    "escalation": {
      "machine": "defect",
      "roles": [
        "triager",
        "administrator"
      ],
      "provenances": [
        "authenticated-human"
      ],
      "reasonRequired": true
    }
  },
  "errorCodes": [
    "outcome_mismatch",
    "attempt_mismatch",
    "duplicate_attempt",
    "independence_required",
    "escalation_required",
    "author_mismatch",
