<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore (NuGet is unreachable in this environment and no third-party
  package is used). All remote feeds are cleared. The only package the projects
  consume is FSharp.Core, which the .NET SDK ships in
  <sdk>/FSharp/library-packs and adds as a restore source itself.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
